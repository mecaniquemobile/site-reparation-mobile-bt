<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Réparation Mobile BT</title>
    <style>
        /* --- Style général --- */
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 0;
            background: #f9f9f9;
            color: #222;
        }

        header {
            background: #000;
            color: #fff;
            padding: 20px 0;
            text-align: center;
        }

        header img {
            max-height: 80px;
            margin-bottom: 10px;
        }

        nav {
            display: flex;
            justify-content: center;
            gap: 30px;
            background: #111;
            padding: 10px 0;
        }

        nav a {
            color: #fff;
            text-decoration: none;
            font-weight: bold;
        }

        nav a:hover {
            text-decoration: underline;
        }

        section {
            padding: 50px 20px;
            max-width: 1000px;
            margin: auto;
        }

        h2 {
            text-align: center;
            margin-bottom: 30px;
        }

        .services {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
            justify-content: center;
        }

        .service {
            background: #fff;
            padding: 25px;
            border-radius: 12px;
            flex: 1 1 250px;
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
            text-align: center;
            transition: transform 0.3s;
        }

        .service:hover {
            transform: translateY(-5px);
        }

        footer {
            background: #111;
            color: #fff;
            text-align: center;
            padding: 20px 0;
        }

        @media(max-width:600px){
            nav {
                flex-direction: column;
            }
        }

        .btn-contact {
            display: inline-block;
            padding: 12px 25px;
            background: #222;
            color: #fff;
            text-decoration: none;
            border-radius: 5px;
            margin-top: 15px;
            transition: background 0.3s;
        }

        .btn-contact:hover {
            background: #555;
        }

        p {
            line-height: 1.6;
        }
    </style>
</head>
<body>

<header>
    <!-- Remplace "logo.png" par ton vrai logo -->
    <img src="logo.png" alt="Réparation Mobile BT Logo">
    <h1>Réparation Mobile BT</h1>
    <p>On vient chez toi, on répare, tu repars tranquille!</p>
</header>

<nav>
    <a href="#services">Services</a>
    <a href="#contact">Contact</a>
</nav>

<section id="services">
    <h2>Nos Services</h2>
    <div class="services">
        <div class="service">
            <h3>Changement de Bearing</h3>
            <p>Rapide et efficace directement à ton domicile.</p>
        </div>
        <div class="service">
            <h3>Réparation de Cardans</h3>
            <p>On remet ton véhicule en marche sans tracas.</p>
        </div>
        <div class="service">
            <h3>Entretien & Inspection</h3>
            <p>On vérifie tout pour éviter les mauvaises surprises.</p>
        </div>
        <div class="service">
            <h3>Autres Réparations Mobiles</h3>
            <p>Peu importe le problème, on se déplace et on règle ça.</p>
        </div>
    </div>
</section>

<section id="contact">
    <h2>Contactez-nous</h2>
    <p style="text-align:center;">📞 Téléphone: <strong>514-123-4567</strong></p>
    <p style="text-align:center;">📍 Service disponible partout au Québec</p>
    <div style="text-align:center;">
        <a class="btn-contact" href="tel:5141234567">Appelle-nous maintenant!</a>
    </div>
</section>

<footer>
    <p>© 2026 Réparation Mobile BT – Tous droits réservés</p>
</footer>

</body>
</html>
